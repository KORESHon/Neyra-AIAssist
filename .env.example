# Скопируйте в ".env" в корне проекта и заполните значения.
# Файл .env в git не коммитится. Секреты сюда не коммитьте.

# ════════════════════════════════════════════════════════════
# 1) LLM / OpenRouter
# ════════════════════════════════════════════════════════════
# Chat/brain/memory + STT при voice.is_local=false и voice.cloud.stt.provider=openrouter
# (POST /api/v1/audio/transcriptions — OpenRouter STT docs). Отдельный ключ для STT не нужен.
OPENROUTER_API_KEY=

# Опционально: общий ключ для профилей llm.api_key / не-OpenRouter
# LLM_API_KEY=

# ════════════════════════════════════════════════════════════
# 2) Discord (плагин interfaces/discord)
# ════════════════════════════════════════════════════════════
# Токен бота; настройки каналов — interfaces/discord/config.yaml
DISCORD_TOKEN=

# ════════════════════════════════════════════════════════════
# 3) Voice — STT / TTS секреты
# ════════════════════════════════════════════════════════════
# Канон config.yaml:
#   voice.is_local: true  → local.stt (faster-whisper) / local.tts
#   voice.is_local: false → cloud.stt.provider + cloud.tts
# cloud.stt.provider: deepgram | groq | openrouter
#
# OpenRouter Whisper: OPENROUTER_API_KEY выше + provider=openrouter
#   model: openai/whisper-large-v3-turbo (~$0.04/час)
#   docs: https://openrouter.ai/docs/guides/overview/multimodal/stt
#
# Deepgram (cloud.stt.provider=deepgram)
DEEPGRAM_API_KEY=

# Groq Whisper (cloud.stt.provider=groq)
GROQ_API_KEY=

# Yandex SpeechKit TTS (voice.cloud.tts)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_ID_KEY=

# ════════════════════════════════════════════════════════════
# 4) Internal HTTP API (плагин interfaces/internal_api)
# ════════════════════════════════════════════════════════════
# Это НЕ «облачный» API: python main.py поднимает FastAPI на машине
# (host/port — interfaces/internal_api/config.yaml).
# Опционально Bearer для /v1 и WebSocket (пусто = без авторизации).
# INTERNAL_API_TOKEN=
# INTERNAL_API_VIEWER_TOKEN=
# INTERNAL_API_MAINT_TOKEN=
# WEBHOOK_INBOUND_SECRET=

# Docker / привязка HTTP API (перекрывает config после merge)
# INTERNAL_API_BIND_HOST=0.0.0.0

# Разрешить POST /v1/debug/lifecycle (в compose часто задаётся автоматически)
# NEYRA_DEBUG_LIFECYCLE=1

# ════════════════════════════════════════════════════════════
# 5) Модели / Hugging Face
# ════════════════════════════════════════════════════════════
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# ════════════════════════════════════════════════════════════
# 6) Плагины / прочее
# ════════════════════════════════════════════════════════════
# YANDEX_SEARCH_API_KEY=
# SCREEN_PROXY_SECRET=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# AGENT_PROXY_SECRET_KEY=
